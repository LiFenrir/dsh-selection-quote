{
  "name": "@lifenrir/dsh-selection-quote",
  "version": "0.1.2",
  "description": "在 DSH 会话中划选文字，一键引用到输入框。Quote selected message text into the composer in one click.",
  "license": "MIT",
  "author": "LiFenrir",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "selection",
    "quote",
    "citation",
    "composer"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.1-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-api-session-controller": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-store": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-input-trigger": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-session": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiFenrir/dsh-selection-quote.git"
  },
  "homepage": "https://github.com/LiFenrir/dsh-selection-quote#readme",
  "bugs": "https://github.com/LiFenrir/dsh-selection-quote/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
